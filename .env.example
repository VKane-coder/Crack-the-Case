# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true once the Google provider is configured in Supabase
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token: scripts/supabase-admin.ts (migrations + auth config via Management API)
SUPABASE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# "fake" uses a scripted patient instead of the Claude API (e2e and UI work; ignored on Vercel production)
PATIENT_LLM=
# Deepgram key needs the Member role (it mints 30-second browser tokens)
DEEPGRAM_API_KEY=
# Optional: DEEPGRAM_MODEL (default nova-3-medical), DEEPGRAM_LANGUAGE (default en), DEEPGRAM_USD_PER_MINUTE
ELEVENLABS_API_KEY=
# JSON map of case voice_profile → ElevenLabs voice id (npm run voices:list), and a fallback voice
ELEVENLABS_VOICE_MAP=
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional: ELEVENLABS_USD_PER_1K_CHARS for cost logging
# "fake" uses a scripted recogniser and silent audio (e2e; ignored on Vercel production)
VOICE_PROVIDERS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
